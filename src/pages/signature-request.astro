---
/**
 * Unlisted email-signature request form (replaces the two Asana forms). noindex, not in sitemap.xml,
 * no nav link. Posts to netlify/functions/signature-request.mjs, which emails the routed AgentMail inbox.
 */
import contact from '../content/pages/contact.json';
import SiteLayout from '../layouts/SiteLayout.astro';
const SITE_KEY = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';
const PRODUCTS = ['FTL','LTL','Ocean','Air','International','Transportation','Crating','3PL','Warehousing','Storage','Distribution','Fulfillment','E-Commerce','Parcel','Delivery','Final Mile','Cross Docking','Installation','White Glove','Consultations'];
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/"/g, '&quot;');
const opt = ' <span class="sr-opt">(optional)</span>';
const req = ' <span class="sr-req" aria-hidden="true">*</span>';
const field = (id: string, label: string, opts: { type?: string; req?: boolean; hint?: string; extra?: string } = {}) =>
  `<div class="sr-f"><label for="${id}">${label}${opts.req ? req : opt}</label>` +
  (opts.hint ? `<div class="sr-hint" id="${id}-h">${opts.hint}</div>` : '') +
  `<input id="${id}" name="${id}" type="${opts.type ?? 'text'}"${opts.req ? ' required' : ''} aria-describedby="${opts.hint ? `${id}-h ` : ''}${id}-e" ${opts.extra ?? ''}/>` +
  `<div class="sr-ferr" id="${id}-e"></div></div>`;
const main = `
<style>
.sr-page{background:#fff;color:#1f2a36;font-family:'Open Sans',sans-serif;font-size:16px;line-height:1.5}
.sr-wrap{max-width:640px;margin:0 auto;padding:8px 20px 64px}
.sr-intro{text-align:center;margin:0 0 28px}
.sr-intro h1{font-size:30px;line-height:1.25;margin:0 0 10px;color:var(--primary-darkblue,#2b2a6b);letter-spacing:.02em}
.sr-intro p{font-size:17px;color:#3d4b59;margin:0}
.sr-intro .sr-reqnote{font-size:15px;margin-top:10px}
.sr-sec{border:1px solid #d5dce3;border-radius:10px;padding:22px 22px 6px;margin:0 0 22px;background:#fff}
.sr-sec>legend,.sr-sec h2{font-size:20px;font-weight:700;color:var(--primary-darkblue,#2b2a6b);margin:0 0 16px;padding:0;line-height:1.3}
.sr-sec>legend{float:left;width:100%}.sr-sec>legend+*{clear:both}
.sr-f{margin:0 0 20px}
.sr-f>label,.sr-leg{display:block;font-weight:700;font-size:16px;color:#1f2a36;margin:0 0 4px;text-align:left}
.sr-req{color:#b3261e}.sr-opt{font-weight:400;color:#55626f}
.sr-hint{font-size:14px;line-height:1.45;color:#55626f;margin:0 0 8px}
.sr-f input[type=text],.sr-f input[type=email],.sr-f input[type=tel],.sr-f input[type=url],.sr-f select,.sr-f textarea{display:block;width:100%;box-sizing:border-box;min-height:48px;padding:12px 14px;border:1.5px solid #8a96a3;border-radius:6px;background:#fff;color:#1f2a36;font:inherit;font-size:16px;margin:0}
.sr-f textarea{min-height:96px}
.sr-f input:focus,.sr-f select:focus,.sr-f textarea:focus{outline:3px solid rgba(0,119,154,.35);outline-offset:1px;border-color:#00779a}
.sr-f [aria-invalid=true]{border-color:#b3261e}
.sr-ferr{color:#b3261e;font-size:14px;font-weight:600;margin-top:6px}.sr-ferr:empty{display:none}
.sr-prod{display:grid;grid-template-columns:1fr 1fr;gap:8px 16px}
.sr-prod label{display:flex;align-items:center;gap:10px;font-weight:400;min-height:40px;padding:6px 10px;border:1px solid #d5dce3;border-radius:6px;cursor:pointer;margin:0}
.sr-prod input{width:18px;height:18px;accent-color:#00779a;margin:0}
.sr-prod label:has(input:checked){border-color:#00779a;background:#e8f4f8}
.sr-prod label:has(input:focus-visible){outline:3px solid rgba(0,119,154,.35)}
.sr-count{font-size:14px;font-weight:600;color:#3d4b59;margin:10px 0 0}
.sr-drop{position:relative;display:flex;align-items:center;gap:16px;padding:18px;border:2px dashed #8a96a3;border-radius:10px;background:#f6f8fa;cursor:pointer;font-weight:400;text-align:left}
.sr-drop.is-over,.sr-drop:hover{border-color:#00779a;background:#e8f4f8}
.sr-drop:focus-within{outline:3px solid rgba(0,119,154,.35);border-color:#00779a}
.sr-drop input{position:absolute;inset:0;opacity:0;width:100%;height:100%;cursor:pointer}
.sr-thumb{flex:0 0 72px;width:72px;height:72px;border-radius:8px;background:#dfe5ea center/cover no-repeat;display:flex;align-items:center;justify-content:center;color:#55626f;font-size:28px}
.sr-drop strong{display:block;color:#00779a}.sr-drop span.sr-fname{display:block;font-size:14px;color:#3d4b59;word-break:break-all}
.sr-hp{position:absolute;left:-10000px;width:1px;height:1px;overflow:hidden}
.sr-msg{padding:16px;border-radius:6px;margin:0 0 20px;font-size:16px}.sr-ok{background:#e8f5e9;border:1px solid #2e7d32;color:#1b4d20}.sr-err{background:#fdecea;border:1px solid #b3261e;color:#7a1712}
.sr-submit{display:block;width:100%;min-height:54px;margin:8px 0 0;padding:14px 20px;border:0;border-radius:8px;background:#00779a;color:#fff;font:inherit;font-size:18px;font-weight:700;cursor:pointer}
.sr-submit:hover{background:#005f7b}.sr-submit:focus-visible{outline:3px solid #2b2a6b;outline-offset:2px}.sr-submit:disabled{opacity:.7;cursor:wait}
.sr-ts{margin:0 0 12px}
fieldset.sr-sec{min-width:0}
.sr-pair{display:grid;grid-template-columns:150px 1fr;gap:0 12px}
.sr-preview img{max-width:none}.sr-preview{border:1px solid #d5dce3;border-radius:6px;padding:16px;background:#fff;overflow-x:auto;margin:0 0 16px}
.sr-actions{display:flex;gap:12px}.sr-actions .sr-submit{margin:0}.sr-alt{background:#fff;color:#00779a;border:2px solid #00779a}.sr-alt:hover{background:#e8f4f8}
.sr-cert{display:flex;gap:10px;align-items:flex-start;font-size:16px;line-height:1.45}.sr-cert input{width:22px;height:22px;margin-top:2px;flex:none}
.sr-f input[readonly]{background:#eef1f4;color:#3a4654}.sr-who{font-size:15px;color:#3a4654}
#sr-form,#sr-form legend,#sr-form .sr-hint,#sr-form .sr-count,#sr-form .sr-ferr,#sr-form label{text-align:left}#sr-form .sr-submit{text-align:center}
@media (max-width:480px){.sr-sec{padding:18px 16px 4px}.sr-intro h1{font-size:26px}.sr-drop{padding:14px}}
</style>
<div class="section sr-page"><div class="sr-wrap">
<div class="sr-intro"><h1>Email Signature Request</h1>
<p>Fill out this form and we'll build your email signature, usually within 7 to 10 business days. Bailey's Moving &amp; Storage and Legacy Transportation signatures are built instantly on this page.</p>
<p class="sr-who" id="sr-who" hidden></p>
<p class="sr-reqnote">Fields marked <span class="sr-req">*</span> are required.</p></div>
<div id="sr-status" role="status" aria-live="polite"></div>
<form id="sr-form" action="/api/signature-request" method="post" enctype="multipart/form-data" novalidate>
<fieldset class="sr-sec"><legend>Your company</legend>
<div class="sr-f"><label for="company">Company${req}</label>
<select id="company" name="company" required aria-describedby="company-e"><option value="">Select your company…</option>
<option value="baileys-group">Bailey's Group (corporate)</option>
<option value="baileys-logistics">Bailey's Logistics</option>
<option value="baileys-moving">Bailey's Moving &amp; Storage</option>
<option value="baileys-workplace">Bailey's Moving &amp; Storage: Workplace</option>
<option value="legacy-transportation">Legacy Transportation Systems</option></select><div class="sr-ferr" id="company-e"></div></div>
</fieldset>
<fieldset class="sr-sec"><legend>About you</legend>
<div data-only="baileys-group baileys-logistics baileys-moving legacy-transportation">${field('name', 'Your name', { req: true, extra: 'autocomplete="name" maxlength="100"' })}</div>
<div data-only="baileys-workplace" hidden>${field('first_name', 'First name', { req: true, extra: 'autocomplete="given-name" maxlength="60"' })}
${field('last_name', 'Last name', { req: true, extra: 'autocomplete="family-name" maxlength="60"' })}</div>
${field('title', 'Your title', { req: true, extra: 'autocomplete="organization-title" maxlength="120"' })}
</fieldset>
<fieldset class="sr-sec"><legend>Contact</legend>
${field('email', 'Your email address', { type: 'email', req: true, hint: 'Filled in from your sign-in, using the domain for the brand you picked. Change it if you use a different address or alias.', extra: 'autocomplete="email" maxlength="160"' })}
<div data-only="baileys-group baileys-logistics">${field('phone', 'Your phone number', { type: 'tel', req: true, hint: 'Only one phone number appears on a Bailey\'s Group signature.', extra: 'autocomplete="tel" maxlength="40"' })}
</div><div data-only="baileys-group baileys-logistics baileys-workplace">${field('linkedin', 'Your personal LinkedIn URL', { type: 'url', hint: 'The link to your profile, e.g. https://www.linkedin.com/in/your-name', extra: 'maxlength="200" placeholder="https://www.linkedin.com/in/"' })}</div>
</fieldset>
<fieldset class="sr-sec" data-only="baileys-group baileys-logistics baileys-workplace"><legend>Headshot</legend>
<div class="sr-f"><div class="sr-leg" id="headshot-l">Your headshot${req}</div>
<div class="sr-hint" id="headshot-h">JPG or PNG, up to 10 MB. Shoulders and above, square, against a plain background (not pure white).</div>
<label class="sr-drop" id="sr-drop" for="headshot"><span class="sr-thumb" id="sr-thumb" aria-hidden="true">&#128247;</span>
<span><strong id="sr-drop-t">Choose a photo or drag it here</strong><span class="sr-fname" id="sr-fname">No file selected</span></span>
<input id="headshot" name="headshot" type="file" accept="image/jpeg,image/png" required aria-labelledby="headshot-l" aria-describedby="headshot-h headshot-e"/></label>
<div class="sr-ferr" id="headshot-e"></div></div>
</fieldset>
<fieldset class="sr-sec" data-only="baileys-logistics" hidden><legend>Logistics details</legend>
<div class="sr-f"><label for="phone_type">Phone number type${opt}</label>
<select id="phone_type" name="phone_type"><option value="">Select…</option><option>Mobile</option><option>Office</option><option>Direct</option></select></div>
${field('phone2', 'Second phone number', { hint: 'Include the type (mobile, office, direct…).', type: 'tel', extra: 'maxlength="60"' })}
<div class="sr-f" role="group" aria-labelledby="products-l"><div class="sr-leg" id="products-l">Products to feature${opt}</div>
<div class="sr-hint">Pick 3 or 4 (5 if they're short words).</div><div class="sr-prod">
${PRODUCTS.map((p) => `<label><input type="checkbox" name="products" value="${esc(p)}"/> ${esc(p)}</label>`).join('')}
</div><p class="sr-count" id="sr-count" aria-live="polite">0 selected</p></div>
<div class="sr-f"><label for="card_address">Business card shipping address${opt}</label>
<textarea id="card_address" name="card_address" rows="3" maxlength="400"></textarea></div>
</fieldset>
<fieldset class="sr-sec" data-only="baileys-moving legacy-transportation baileys-workplace" hidden><legend>Phone numbers</legend>
<div class="sr-hint" data-only="baileys-moving legacy-transportation">These brands don't need a headshot. Your signature is built right here on this page, nothing is sent anywhere.</div>
<div class="sr-pair"><div class="sr-f"><label for="g_phone1_label">Phone 1 type${req}</label>
<select id="g_phone1_label" name="g_phone1_label" required><option>office</option><option>direct</option><option>mobile</option><option>cell</option><option>fax</option></select></div>
${field('g_phone1', 'Phone 1', { type: 'tel', req: true, extra: 'autocomplete="tel" maxlength="40" placeholder="(801) 555-0100"' })}</div>
<div class="sr-pair"><div class="sr-f"><label for="g_phone2_label">Phone 2 type${opt}</label>
<select id="g_phone2_label" name="g_phone2_label"><option>mobile</option><option>cell</option><option>office</option><option>direct</option><option>fax</option></select></div>
${field('g_phone2', 'Phone 2', { type: 'tel', extra: 'maxlength="40" placeholder="(801) 555-0199"' })}</div>
</fieldset>
<section class="sr-sec" data-only="baileys-moving legacy-transportation" hidden aria-labelledby="sr-prev-h"><h2 id="sr-prev-h">Your signature</h2>
<div class="sr-hint">Updates as you type. Copy it and paste into Outlook: File &gt; Options &gt; Mail &gt; Signatures (or Settings &gt; Signatures in Outlook on the web).</div>
<div class="sr-preview" id="sr-preview"></div>
<div class="sr-actions"><button type="button" class="sr-submit" id="sr-copy">Copy signature</button><button type="button" class="sr-submit sr-alt" id="sr-dl">Download .htm</button></div>
<p class="sr-count" id="sr-gen-msg" role="status" aria-live="polite"></p>
</section>
<div data-only="baileys-group baileys-logistics baileys-workplace">
<fieldset class="sr-sec"><legend>Confirm</legend>
<div class="sr-f"><label class="sr-cert"><input id="certify" name="certify" type="checkbox" value="yes" required aria-describedby="certify-e"/> I am an employee of Bailey's Group or one of its companies, and this request is for me.${req}</label><div class="sr-ferr" id="certify-e"></div></div>
</fieldset>
<div class="sr-hp" aria-hidden="true"><label for="website">Leave this empty</label><input id="website" name="website" type="text" tabindex="-1" autocomplete="off"/></div>
${SITE_KEY ? `<div class="cf-turnstile sr-ts" data-sitekey="${esc(SITE_KEY)}"></div>` : ''}
<button type="submit" class="sr-submit">Submit request</button>
</div>
</form></div></div>`;
const p = {
  ...contact,
  url: '/signature-request',
  navCurrent: [],
  headPage: [
    '<title>Email Signature Request | Bailey\'s Group</title>',
    '<meta content="Request or build an email signature for Bailey\'s Group companies." name="description"/>',
    '<meta name="robots" content="noindex, nofollow"/>',
  ],
  main,
  tailPage: [
    ...contact.tailPage,
    ...(SITE_KEY ? ['<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>'] : []),
    '<script src="/signature-generator.js" defer></script>',
    '<script src="/signature-request.js" defer></script>',
  ],
};
---
<SiteLayout p={p} />
